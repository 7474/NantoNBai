<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- 既存コードの警告を増やさずに、新しい描画コードで ? 表記を使うため -->
    <Nullable>annotations</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 描画に使うフォントは実行環境に頼らず埋め込む (OFL 1.1 / fonts/OFL.txt) -->
    <EmbeddedResource Include="fonts\BIZUDPGothic-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nanto-n-bai-template(1).pptx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="nanto-n-bai-template.pptx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
